/*
 * Shared look for every YKY Toolkit window and inspector.
 * Theme-neutral: translucent greys plus one accent, so the rules read the same in the light and the dark editor theme.
 * Per-window .uss files load after this one, so their own rules keep winning where they overlap.
 */

/* ---------- page ---------- */

.root,
.yky-page {
    padding: 12px;
    flex-grow: 1;
}

/* ---------- section ---------- */

.yky-section {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--yky-accent-text, rgb(120, 165, 255));
    margin: 16px 0 6px 0;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--yky-accent-line, rgba(96, 141, 235, 0.55));
}

/* ---------- card ---------- */

.yky-card {
    padding: 8px;
    margin: 4px 0;
    background-color: rgba(128, 128, 128, 0.07);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.22);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.yky-hint,
.placeholder {
    font-size: 10px;
    color: rgba(140, 140, 140, 0.95);
    white-space: normal;
}

/* ---------- buttons ---------- */

/* Class selectors: the default theme styles these elements through their class, which beats a type selector. */
Button,
.unity-button {
    min-height: 23px;
    padding: 2px 12px;
    margin: 2px;
    /* The default button chrome is a nine slice image; clearing it lets the colours below show. */
    background-image: none;
    background-color: rgba(128, 128, 128, 0.16);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

Button:hover,
.unity-button:hover {
    border-color: var(--yky-accent, rgb(76, 141, 255));
    background-color: var(--yky-accent-22, rgba(76, 141, 255, 0.22));
}

Button:active,
.unity-button:active {
    background-color: var(--yky-accent-34, rgba(76, 141, 255, 0.34));
}

.yky-button--primary {
    color: rgb(255, 255, 255);
    background-image: none;
    background-color: var(--yky-accent, rgb(76, 141, 255));
    border-color: var(--yky-accent-border, rgb(60, 122, 238));
}

.yky-button--primary:hover {
    background-color: var(--yky-accent-hover, rgb(94, 155, 255));
    border-color: var(--yky-accent-hover, rgb(94, 155, 255));
}

.cell {
    flex-grow: 1;
    margin: 2px 3px;
}

.yky-button--small {
    min-height: 18px;
    height: 18px;
    padding: 0 8px;
    margin: 0;
    font-size: 10px;
}

.yky-list-header {
    flex-direction: row;
    align-items: center;
    margin: 2px 2px 4px 2px;
}

.yky-list-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--yky-accent-text, rgb(120, 165, 255));
}

/* ---------- layout helpers ---------- */

.yky-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.yky-spacer {
    flex-grow: 1;
}

.yky-columns {
    flex-direction: row;
    flex-grow: 1;
}

.yky-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    margin: 4px;
}

/* A list that shares a column with other elements has to be able to shrink, or its content pushes the rest out. */
.yky-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.yky-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
}

.yky-list-row {
    margin: 2px 0;
    padding: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.yky-list-row--selected {
    background-color: var(--yky-accent-12, rgba(76, 141, 255, 0.12));
}

.yky-list-empty,
.unity-list-view__empty-label {
    margin: 16px 8px;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(140, 140, 140, 0.95);
    white-space: normal;
}

/* ---------- list count ---------- */

.unity-list-view__size-field {
    margin: 0 4px 0 6px;
    min-width: 36px;
    max-width: 52px;
    height: 16px;
    background-color: transparent;
    border-width: 0;
}

.unity-list-view__size-field .unity-base-text-field__input {
    padding: 0 6px;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: rgba(128, 128, 128, 0.28);
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* ---------- language picker ---------- */

PopupField {
    margin: 6px 2px 2px 2px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.25);
    align-items: center;
}

PopupField .unity-base-field__label {
    min-width: 0;
    flex-grow: 1;
}

PopupField .unity-base-field__input {
    flex-grow: 0;
    min-width: 140px;
    max-width: 220px;
}

.yky-count {
    margin-left: 6px;
    padding: 0 6px;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: rgba(128, 128, 128, 0.28);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.yky-row {
    flex-direction: row;
    align-items: center;
}

.yky-row--end {
    justify-content: flex-end;
}

.yky-stack {
    flex-direction: column;
    margin-top: 6px;
}

.yky-hint {
    margin: 0 0 3px 0;
}

/* The + / - of a custom row and of the built-in list footer must look like the same button. */
.yky-icon-button,
.unity-list-view__footer .unity-button {
    width: 22px;
    min-width: 22px;
    height: 20px;
    padding: 0;
    margin: 0 0 0 4px;
    font-size: 13px;
    -unity-text-align: middle-center;
    background-image: none;
    background-color: transparent;
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.yky-icon-button:hover,
.unity-list-view__footer .unity-button:hover {
    background-color: var(--yky-accent-30, rgba(76, 141, 255, 0.30));
}

.yky-icon-button:active,
.unity-list-view__footer .unity-button:active {
    background-color: var(--yky-accent-45, rgba(76, 141, 255, 0.45));
}

.yky-inline-label {
    min-width: 96px;
    margin-right: 6px;
}

/* A list inside a card is framed by the card, so it does not need its own border. */
.yky-card ListView {
    margin: 0;
    border-width: 0;
}

/* ---------- toolbar ---------- */

Toolbar,
.unity-toolbar {
    min-height: 26px;
    padding: 2px;
    margin-bottom: 8px;
    background-color: rgba(128, 128, 128, 0.10);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.30);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

ToolbarButton,
.unity-toolbar-button {
    padding: 2px 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

ToolbarButton:hover,
.unity-toolbar-button:hover {
    background-color: var(--yky-accent-20, rgba(76, 141, 255, 0.20));
}

/* ---------- search field ---------- */

/* The global button rule clears every background image, including the magnifier and the clear "x", so the
   search field restores its own and draws the rest of the chrome here. */
.yky-search {
    flex-direction: row;
    align-items: center;
    height: 22px;
    min-height: 22px;
    padding: 0 2px;
    background-color: rgba(128, 128, 128, 0.14);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.yky-search:hover {
    border-color: var(--yky-accent-line-strong, rgba(96, 141, 235, 0.70));
}

.yky-search .unity-search-field-base__search-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    padding: 0;
    margin: 0 2px;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/search.png?fileID=2800000&guid=14ca449f42657974ebdfa6883b6c36f4&type=3");
    background-size: 12px 12px;
    background-position: center;
    background-repeat: no-repeat;
}

.yky-search .unity-search-field-base__search-button:hover,
.yky-search .unity-search-field-base__search-button:active {
    background-color: transparent;
}

.yky-search .unity-search-field-base__text-field {
    flex-grow: 1;
    margin: 0;
    border-width: 0;
    background-color: transparent;
    min-height: 18px;
}

.yky-search .unity-search-field-base__text-field__input {
    border-width: 0;
    background-color: transparent;
    padding: 0;
    font-size: 11px;
    min-height: 18px;
}

.yky-search .unity-search-field-base__cancel-button {
    width: 16px;
    min-width: 16px;
    height: 16px;
    min-height: 16px;
    padding: 0;
    margin: 0 2px;
    border-width: 0;
    background-color: transparent;
    background-image: none;
    font-size: 12px;
    color: rgba(200, 208, 220, 0.85);
}

.yky-search .unity-search-field-base__cancel-button:hover,
.yky-search .unity-search-field-base__cancel-button:active {
    background-color: transparent;
    color: rgb(255, 255, 255);
}

/* Unity hides the default icon through this class; with a text "x" the button has to be removed from layout. */
.yky-search .unity-search-field-base__cancel-button--off {
    display: none;
}

/* ---------- list ---------- */

ListView,
.unity-list-view {
    margin: 4px 0;
    min-height: 0;
    background-color: rgba(128, 128, 128, 0.06);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.28);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.unity-list-view__item:hover {
    background-color: var(--yky-accent-12, rgba(76, 141, 255, 0.12));
}

/* The built-in add/remove footer is painted with a solid dark toolbar, which reads as a black frame in a card. */
.unity-list-view__footer {
    padding: 1px 2px;
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

/* A list footer is built by the toolkit instead of Unity's dark toolbar: reset, + and - in the bottom-right
   corner, the same in every preferences list. */
.yky-list-footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-top: 4px;
}

.yky-list-footer .yky-icon-button {
    margin-left: 4px;
}

/* The reset icon is used in a card title and in the list footer. The footer clears its button images, so this rule
   has to come after it to keep the icon on the footer button. */
.yky-icon-button.yky-button-icon--reset {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/reset.png?fileID=2800000&guid=d87bcb1c5259d6e41934305859e8c37a&type=3");
    background-size: 14px 14px;
    background-position: center;
    background-repeat: no-repeat;
}

/* ---------- foldout ---------- */

Foldout,
.unity-foldout {
    margin: 6px 0;
}

.unity-foldout__input .unity-toggle__text {
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------- fields ---------- */

TextField .unity-text-element,
TextField .unity-base-text-field__input {
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* ---------- table header ---------- */

.tableHeader {
    padding: 4px 6px;
    margin-top: 4px;
    background-color: var(--yky-accent-16, rgba(76, 141, 255, 0.16));
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.headerCell {
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------- icons ---------- */

.yky-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 6px;
    background-repeat: no-repeat;
    background-size: 16px 16px;
    background-position-x: center;
    background-position-y: center;
}

.yky-icon--section {
    width: 18px;
    height: 18px;
    background-size: 18px 18px;
}

.yky-icon--header {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    background-size: 30px 30px;
}

.yky-card__title {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 20px;
    margin: 2px 0 8px 0;
}

.yky-card__title .yky-section {
    margin: 0;
    padding: 0;
    border-bottom-width: 0;
}

.yky-icon--settings {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/settings.png?fileID=2800000&guid=bcd2e0e1b81a2034a98b6cd2c90f9956&type=3");
}

.yky-icon--preferences {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/preferences.png?fileID=2800000&guid=3d4c646e69dbf8f4d955333eea64c89e&type=3");
}
.yky-icon--language {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/language.png?fileID=2800000&guid=371f21e69eb122441accf9a5dd98bcf5&type=3");
}

.yky-icon--theme {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/theme.png?fileID=2800000&guid=33ba37a80a674ac2b2f7c616f33166b0&type=3");
}

.yky-icon--upm-installer {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/upm-installer.png?fileID=2800000&guid=5ab713cc40cfc93438365a1d080586ed&type=3");
}

.yky-icon--packages {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/packages.png?fileID=2800000&guid=ef61df4e93e0e6c4eb82b56da63dc0e0&type=3");
}

.yky-icon--package-list {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/package-list.png?fileID=2800000&guid=6435467fe0ea91c45a1e402961f4075e&type=3");
}

.yky-icon--package-list-maker {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/package-list-maker.png?fileID=2800000&guid=45a2c72e4d8c5ca46a94e238ac03c33c&type=3");
}

.yky-icon--install {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/install.png?fileID=2800000&guid=d999d9e925fb9564d855507bf4d1c5ba&type=3");
}

.yky-icon--import {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/import.png?fileID=2800000&guid=d637deac9e8d79443b350bc3ef68a34a&type=3");
}

.yky-icon--remove {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/remove.png?fileID=2800000&guid=a0a85867382f9c641b6fbacee483dc93&type=3");
}

.yky-icon--update {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/update.png?fileID=2800000&guid=1dfc89f49047dfd4b95eabd0fdbdbffc&type=3");
}

.yky-icon--clear {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/clear.png?fileID=2800000&guid=034e831a60985e240a8ae1c46bffcb94&type=3");
}

.yky-icon--upgrade {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/upgrade.png?fileID=2800000&guid=a90abf58db62a7a49a7334937ba917e4&type=3");
}

.yky-icon--import-to-maker {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/import-to-maker.png?fileID=2800000&guid=c00d245d8ee3d84408287a23c6655113&type=3");
}

.yky-icon--import-watcher {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/import-watcher.png?fileID=2800000&guid=d062e4b3fa9b7044ca82ec77ab078610&type=3");
}

.yky-icon--delete-history {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/delete-history.png?fileID=2800000&guid=82fdc8dfe1fd3244487006c115a3c899&type=3");
}

.yky-icon--resource-monitor {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/resource-monitor.png?fileID=2800000&guid=f76f274a6a76d8f4f828b3e46b0a25b0&type=3");
}

.yky-icon--copy {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/copy.png?fileID=2800000&guid=f8379f706ae3d4841838ff5cc924da0a&type=3");
}

.yky-icon--paste {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/paste.png?fileID=2800000&guid=3d32b439cc5c09f4f93312cf317a8019&type=3");
}

.yky-button--icon {
    padding-left: 28px;
    background-position-x: 8px;
    background-position-y: center;
    background-size: 15px 15px;
    background-repeat: no-repeat;
}

.yky-button--install {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/install.png?fileID=2800000&guid=d999d9e925fb9564d855507bf4d1c5ba&type=3");
}

.yky-button--import {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/import.png?fileID=2800000&guid=d637deac9e8d79443b350bc3ef68a34a&type=3");
}

.yky-button--remove {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/remove.png?fileID=2800000&guid=a0a85867382f9c641b6fbacee483dc93&type=3");
}

.yky-button--update {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/update.png?fileID=2800000&guid=1dfc89f49047dfd4b95eabd0fdbdbffc&type=3");
}

.yky-button--clear {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/clear.png?fileID=2800000&guid=034e831a60985e240a8ae1c46bffcb94&type=3");
}

.yky-button--upgrade {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/upgrade.png?fileID=2800000&guid=a90abf58db62a7a49a7334937ba917e4&type=3");
}

.yky-button--import-to-maker {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/import-to-maker.png?fileID=2800000&guid=c00d245d8ee3d84408287a23c6655113&type=3");
}

.yky-button--copy {
    background-image: url("project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/copy.png?fileID=2800000&guid=f8379f706ae3d4841838ff5cc924da0a&type=3");
}
