/*
 * Shared look for every YKY Toolkit window and inspector.
 * Theme-neutral: translucent greys plus one accent, so the rules read the same in the light and the dark editor theme.
 * Per-window .uss files load after this one, so their own rules keep winning where they overlap.
 */

/* ---------- page ---------- */

.root,
.yky-page {
    padding: 12px;
    flex-grow: 1;
}

/* ---------- section ---------- */

.yky-section {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
    margin: 16px 0 6px 0;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(96, 141, 235, 0.55);
}

/* ---------- card ---------- */

.yky-card {
    padding: 8px;
    margin: 4px 0;
    background-color: rgba(128, 128, 128, 0.07);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.22);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.yky-hint,
.placeholder {
    font-size: 10px;
    color: rgba(140, 140, 140, 0.95);
    white-space: normal;
}

/* ---------- buttons ---------- */

/* Class selectors: the default theme styles these elements through their class, which beats a type selector. */
Button,
.unity-button {
    min-height: 23px;
    padding: 2px 12px;
    margin: 2px;
    /* The default button chrome is a nine slice image; clearing it lets the colours below show. */
    background-image: none;
    background-color: rgba(128, 128, 128, 0.16);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.45);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

Button:hover,
.unity-button:hover {
    border-color: rgb(76, 141, 255);
    background-color: rgba(76, 141, 255, 0.22);
}

Button:active,
.unity-button:active {
    background-color: rgba(76, 141, 255, 0.34);
}

.yky-button--primary {
    color: rgb(255, 255, 255);
    background-image: none;
    background-color: rgb(76, 141, 255);
    border-color: rgb(60, 122, 238);
}

.yky-button--primary:hover {
    background-color: rgb(94, 155, 255);
    border-color: rgb(94, 155, 255);
}

.cell {
    flex-grow: 1;
    margin: 2px 3px;
}

/* ---------- layout helpers ---------- */

.yky-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.yky-spacer {
    flex-grow: 1;
}

.yky-columns {
    flex-direction: row;
    flex-grow: 1;
}

.yky-column {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    margin: 4px;
}

/* A list that shares a column with other elements has to be able to shrink, or its content pushes the rest out. */
.yky-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.yky-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
}

.yky-list-row {
    margin: 2px 0;
    padding: 1px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.yky-list-row--selected {
    background-color: rgba(76, 141, 255, 0.12);
}

.yky-list-empty {
    margin: 12px 8px;
    font-size: 12px;
    color: rgba(140, 140, 140, 0.95);
}

.yky-count {
    margin-left: 6px;
    padding: 0 6px;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: rgba(128, 128, 128, 0.28);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.yky-row {
    flex-direction: row;
    align-items: center;
}

.yky-row--end {
    justify-content: flex-end;
}

.yky-stack {
    flex-direction: column;
    margin-top: 6px;
}

.yky-hint {
    margin: 0 0 3px 0;
}

.yky-icon-button {
    width: 22px;
    min-width: 22px;
    height: 20px;
    padding: 0;
    margin: 0 0 0 4px;
    font-size: 13px;
    -unity-text-align: middle-center;
    background-image: none;
    background-color: transparent;
    border-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.yky-icon-button:hover {
    background-color: rgba(76, 141, 255, 0.30);
}

.yky-icon-button:active {
    background-color: rgba(76, 141, 255, 0.45);
}

.yky-inline-label {
    min-width: 96px;
    margin-right: 6px;
}

/* A list inside a card is framed by the card, so it does not need its own border. */
.yky-card ListView {
    margin: 0;
    border-width: 0;
}

/* The card already has padding, so the first heading does not need its own top margin. */
.yky-card > .yky-section:first-child {
    margin-top: 2px;
}

/* ---------- toolbar ---------- */

Toolbar,
.unity-toolbar {
    min-height: 26px;
    padding: 2px;
    margin-bottom: 8px;
    background-color: rgba(128, 128, 128, 0.10);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.30);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

ToolbarButton,
.unity-toolbar-button {
    padding: 2px 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

ToolbarButton:hover,
.unity-toolbar-button:hover {
    background-color: rgba(76, 141, 255, 0.20);
}

/* ---------- list ---------- */

ListView,
.unity-list-view {
    margin: 4px 0;
    min-height: 0;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.28);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.unity-list-view__item:hover {
    background-color: rgba(76, 141, 255, 0.12);
}

/* The built-in add/remove footer is painted with a solid dark toolbar, which reads as a black frame in a card. */
.unity-list-view__footer {
    padding: 1px 2px;
    background-image: none;
    background-color: transparent;
    border-width: 0;
}

.unity-list-view__footer .unity-button {
    min-width: 22px;
    padding: 0 6px;
}

/* ---------- foldout ---------- */

Foldout,
.unity-foldout {
    margin: 6px 0;
}

.unity-foldout__input .unity-toggle__text {
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------- fields ---------- */

TextField .unity-text-element,
TextField .unity-base-text-field__input {
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* ---------- empty state ---------- */

.empty-label,
.delete-history-window__empty-label {
    margin: 24px 12px;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: rgba(140, 140, 140, 0.95);
    white-space: normal;
}

/* ---------- table header ---------- */

.tableHeader {
    padding: 4px 6px;
    margin-top: 4px;
    background-color: rgba(76, 141, 255, 0.16);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

.headerCell {
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
