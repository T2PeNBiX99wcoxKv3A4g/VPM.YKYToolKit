<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/YkyToolkitTheme.uss?guid=34e0c41dada851146aeccffc05549196&amp;type=3"/>
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/UpmInstallerWindow.uss?fileID=7433441132597879392&amp;guid=3a2de8958a2e834458945bec73401276&amp;type=3#UpmInstallerWindow"/>
    <ui:VisualElement class="root" style="flex-grow: 1;">
        <ui:VisualElement class="yky-card">
            <ui:VisualElement class="yky-toolbar">
                <ui:Button text="label.upm_installer_window.install" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="install" class="yky-button--primary"/>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="remove"
                           text="label.upm_installer_window.remove"/>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="update"
                           text="label.upm_installer_window.update"/>
                <ui:Button text="label.upm_installer_window.clear" name="clear" parse-escape-sequences="true"
                           display-tooltip-when-elided="true"/>
            </ui:VisualElement>
            <ui:VisualElement class="yky-toolbar">
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="upgrade"
                           text="label.upm_installer_window.check_and_upgrade"/>
                <ui:VisualElement class="yky-spacer"/>
                <ui:Button text="label.upm_installer_window.import_to_maker" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="importToMaker"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="yky-columns">
            <ui:VisualElement class="yky-card yky-column">
                <ui:Label text="label.upm_installer_window.packages" class="yky-section"/>
                <ui:ListView binding-path="packages" virtualization-method="DynamicHeight"
                             selection-type="Multiple" show-alternating-row-backgrounds="ContentOnly"
                             show-bound-collection-size="false" reorder-mode="Animated" reorderable="true"
                             show-add-remove-footer="false" name="packages" class="yky-list"/>
                <ui:VisualElement class="yky-row yky-row--end">
                    <ui:Button text="+" name="addPackage" class="yky-icon-button"/>
                    <ui:Button text="−" name="removePackage" class="yky-icon-button"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card yky-column">
                <ui:Label text="label.upm_installer_window.package_list" class="yky-section"/>
                <ui:ScrollView name="packageLists" class="yky-scroll"/>
                <ui:VisualElement class="yky-row">
                    <ui:Button text="label.upm_installer_window.import" parse-escape-sequences="true"
                               display-tooltip-when-elided="true" name="import" class="cell"/>
                    <ui:Button text="label.upm_installer_window.remove_selected" parse-escape-sequences="true"
                               display-tooltip-when-elided="true" name="removeSelected" class="cell"/>
                </ui:VisualElement>

                <ui:Label text="label.upm_installer_window.package_list_maker" class="yky-section"/>
                <ui:ListView virtualization-method="DynamicHeight" selection-type="Multiple"
                             show-alternating-row-backgrounds="ContentOnly" reorderable="true"
                             show-add-remove-footer="false" reorder-mode="Animated"
                             show-bound-collection-size="false" binding-path="packageListMaker"
                             name="packageListMaker" class="yky-list"/>
                <ui:VisualElement class="yky-row yky-row--end">
                    <ui:Button text="+" name="addMaker" class="yky-icon-button"/>
                    <ui:Button text="−" name="removeMaker" class="yky-icon-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="yky-stack">
                    <ui:Label text="label.upm_installer_window.package_list_name" class="yky-hint"/>
                    <ui:TextField name="createListName"/>
                    <ui:Button text="label.upm_installer_window.create_and_copy" parse-escape-sequences="true"
                               display-tooltip-when-elided="true" name="createAndCopy"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
