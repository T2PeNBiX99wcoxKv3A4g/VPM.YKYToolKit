<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/ImportWatcherWindow.uss?fileID=7433441132597879392&amp;guid=cb3f7d18f6e8d4e4d8f0d704c12890d4&amp;type=3#ImportWatcherWindow"/>
    <uie:Toolbar>
        <uie:ToolbarButton text="label.refresh" name="refresh"/>
        <uie:ToolbarButton text="label.clear" name="clear"/>
        <uie:ToolbarButton text="label.import_watcher.settings" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="settings"/>
    </uie:Toolbar>
    <ui:ListView selection-type="Multiple" virtualization-method="DynamicHeight" name="importLogList"
                 binding-path="records" show-bound-collection-size="false"
                 show-alternating-row-backgrounds="ContentOnly" style="flex-grow: 1;"/>
    <ui:Label text="No import log." name="importLogEmpty"
              style="unity-font-style: bold; color: rgb(150, 150, 150); margin-top: 6px; margin-left: 6px;"/>
</ui:UXML>
