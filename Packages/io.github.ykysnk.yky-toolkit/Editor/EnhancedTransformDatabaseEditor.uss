/* The shared theme carries the colours; this file holds the database-specific layout. */

.transform-db {
    padding: 8px;
    flex-grow: 1;
}

.transform-db__card {
    margin: 0;
    flex-grow: 1;
}

.transform-db__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.transform-db__title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
}

.transform-db__read-only {
    margin-left: 6px;
    padding: 0 7px;
    font-size: 9px;
    color: rgba(160, 170, 185, 0.95);
    background-color: rgba(128, 128, 128, 0.18);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.transform-db__list {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 6px;
}

.transform-db__item {
    margin: 0;
}

.transform-db-entry {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 2px 4px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.transform-db-entry:hover {
    background-color: rgba(76, 141, 255, 0.12);
}

.transform-db-entry__path {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    color: rgba(205, 205, 205, 0.95);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.transform-db-entry__path--missing {
    color: rgb(230, 125, 125);
}

.transform-db-entry__value {
    width: 54px;
    min-width: 54px;
    font-size: 10px;
    color: rgba(200, 200, 200, 0.95);
    -unity-text-align: middle-center;
}
