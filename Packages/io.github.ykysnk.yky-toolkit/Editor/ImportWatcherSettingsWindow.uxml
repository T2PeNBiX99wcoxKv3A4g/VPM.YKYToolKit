<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/YkyToolkitTheme.uss?guid=34e0c41dada851146aeccffc05549196&amp;type=3"/>
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/ImportWatcherSettingsWindow.uss?fileID=7433441132597879392&amp;guid=14ed0cab3837c8e428a86088225faaa2&amp;type=3#ImportWatcherSettingsWindow"/>
    <ui:ScrollView class="root yky-settings-window">
        <ui:VisualElement class="yky-settings-window__content">
            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--settings"/>
                    <ui:Label text="label.import_watcher.settings" class="yky-section"/>
                </ui:VisualElement>
                <uie:ColorField label="label.import_watcher.color" value="RGBA(0.000, 1.000, 1.000, 1.000)"
                                name="color"/>
                <ui:SliderInt label="label.import_watcher.duration" high-value="500" name="duration"
                              show-input-field="true"/>
                <ui:SliderInt label="label.import_watcher.max_sessions" high-value="1000" name="maxSessions"
                              show-input-field="true"/>
                <ui:VisualElement class="yky-row">
                    <ui:Button name="resetSettings" tooltip="label.import_watcher.reset_colors"
                               class="yky-icon-button yky-button-icon--reset"/>
                    <ui:VisualElement class="yky-spacer"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-list-header">
                    <ui:Label text="label.import_watcher.file_extension_colors" class="yky-list-title"/>
                    <ui:Label name="fileColorCount" text="0" class="yky-count"/>
                </ui:VisualElement>
                <ui:ListView show-alternating-row-backgrounds="ContentOnly" reorderable="true"
                             reorder-mode="Animated" show-add-remove-footer="true" selection-type="Multiple"
                             virtualization-method="DynamicHeight"
                             name="fileColors" show-foldout-header="false"
                             header-title="label.import_watcher.file_extension_colors" class="yky-list"/>
                <ui:VisualElement class="yky-row">
                    <ui:Button name="resetFileColors" tooltip="label.import_watcher.reset_colors"
                               class="yky-icon-button yky-button-icon--reset"/>
                    <ui:VisualElement class="yky-spacer"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
