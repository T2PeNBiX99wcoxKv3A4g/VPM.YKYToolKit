<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/ImportWatcherSettingsWindow.uss?fileID=7433441132597879392&amp;guid=14ed0cab3837c8e428a86088225faaa2&amp;type=3#ImportWatcherSettingsWindow"/>
    <ui:VisualElement style="padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;">
        <ui:Label text="label.import_watcher.settings" parse-escape-sequences="true" display-tooltip-when-elided="true"
                  style="-unity-font-style: bold;"/>
        <uie:ColorField label="label.import_watcher.color" value="RGBA(0.000, 1.000, 1.000, 1.000)" name="color"/>
