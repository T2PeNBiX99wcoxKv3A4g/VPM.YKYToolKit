<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/YkyToolkitTheme.uss?guid=34e0c41dada851146aeccffc05549196&amp;type=3"/>
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/EnhancedTransformDatabaseEditor.uss?fileID=7433441132597879392&amp;guid=4461bdc25d874fe428517dea133c04e6&amp;type=3#EnhancedTransformDatabaseEditor"/>
    <ui:VisualElement class="root transform-db">
        <ui:VisualElement class="yky-card transform-db__card">
            <ui:VisualElement class="transform-db__header">
                <ui:Label text="label.enhanced_transform_database.entries" class="transform-db__title"/>
                <ui:Label name="count" text="0" class="yky-count"/>
                <ui:VisualElement class="yky-spacer"/>
                <ui:Button name="remove" text="label.enhanced_transform_database.remove_selected"
                           class="yky-button--small"/>
            </ui:VisualElement>
            <ui:Label text="label.enhanced_transform_database.info" class="yky-hint"/>
            <ui:ListView binding-path="entries" name="entries" virtualization-method="DynamicHeight"
                         show-alternating-row-backgrounds="None" reorder-mode="Animated"
                         show-bound-collection-size="false" selection-type="Multiple"
                         class="yky-list transform-db__list"/>
            <ui:Label text="label.enhanced_transform_database.no_entries" name="empty" class="yky-list-empty"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
