.transform-editor {
    padding: 2px 0 8px 0;
}

.row {
    flex-direction: row;
}

.transform-card {
    margin: 5px 0;
    padding: 8px 10px 10px 10px;
    border-left-width: 2px;
    border-left-color: rgba(96, 141, 235, 0.55);
}

.transform-card__header {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin: 0 0 4px 0;
}

.transform-card__title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
}

.transform-actions {
    flex-direction: row;
    align-items: center;
}

.transform-action {
    margin-left: 2px;
}

.transform-tools-row {
    flex-direction: row;
    margin: 2px 0;
}

.transform-tool-button {
    flex-grow: 1;
    height: 24px;
    margin: 2px;
    font-size: 10px;
}

.transform-foldout {
    margin-top: 6px;
}

/* ---------- expression cheat sheet ---------- */

.transform-help {
    padding: 2px 2px 4px 2px;
}

.transform-help__hint {
    margin: 0 0 6px 0;
    font-size: 10px;
    color: rgba(150, 150, 150, 0.95);
    white-space: normal;
}

.transform-help__group {
    margin-bottom: 6px;
}

.transform-help__group-title {
    margin: 4px 0 2px 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
}

.transform-help__row {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    padding: 1px 4px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.transform-help__row:hover {
    background-color: rgba(76, 141, 255, 0.14);
}

.transform-help__syntax {
    width: 96px;
    min-width: 96px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(160, 195, 255);
}

.transform-help__description {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    color: rgba(195, 195, 195, 0.95);
    white-space: normal;
}

.transform-help__alt {
    margin-left: 6px;
    font-size: 9px;
    color: rgba(150, 150, 150, 0.85);
}

.transform-help__copied {
    color: rgb(125, 220, 150);
}

.transform-help__copy-hint {
    margin-top: 2px;
    font-size: 9px;
    color: rgba(140, 140, 140, 0.85);
}

/* ---------- expression suggestions ---------- */

.transform-suggest {
    position: absolute;
    display: none;
    padding: 4px;
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.65);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.transform-suggest__list {
    flex-direction: column;
}

.transform-suggest__row {
    flex-direction: row;
    align-items: center;
    padding: 2px 5px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.transform-suggest__row:hover,
.transform-suggest__row--selected {
    background-color: rgba(76, 141, 255, 0.38);
}

.transform-suggest__syntax {
    width: 92px;
    min-width: 92px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(170, 205, 255);
}

.transform-suggest__description {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    color: rgba(215, 215, 215, 0.95);
    white-space: normal;
}

.transform-suggest__footer {
    margin-top: 3px;
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
    font-size: 9px;
    color: rgba(150, 150, 150, 0.9);
}

.transform-path .unity-base-field__label {
    min-width: 90px;
}

.link-slot {
    width: 20px;
    min-width: 20px;
    margin-right: 4px;
    align-self: center;
    justify-content: center;
}

.link-slot .icon-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    background-size: 16px 16px;
    border-radius: 2px;
}

.extra-slot {
    padding: 0;
    margin: 0 0 0 4px;
    justify-content: center;
    align-items: center;
    align-self: center;
}

.icon-button {
    border-radius: 3px;
    border-width: 0;
    padding: 0;
    margin: 0;
    width: 16px;
    height: 16px;
    background-size: 13px 13px;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center;
    align-self: center;
}

.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
    transition: background-color 0.12s ease-in-out;
}

.icon-button.flash {
    background-color: rgba(255, 255, 255, 0.25);
}
