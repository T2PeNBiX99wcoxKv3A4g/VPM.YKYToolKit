.transform-editor {
    padding: 2px 0 8px 0;
}

.row {
    flex-direction: row;
}

.transform-card {
    margin: 5px 0;
    padding: 8px 10px 10px 10px;
    border-left-width: 2px;
    border-left-color: rgba(96, 141, 235, 0.55);
}

.transform-card__header {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin: 0 0 4px 0;
}

.transform-card__title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(120, 165, 255);
}

.transform-actions {
    flex-direction: row;
    align-items: center;
}

.transform-action {
    margin-left: 2px;
    flex-shrink: 0;
}

/* ---------- Unity's default transform UI ---------- */

.transform-default-ui {
    margin: 8px 0 4px 0;
    padding: 6px 8px 8px 8px;
    background-color: rgba(128, 128, 128, 0.05);
    border-width: 1px;
    border-left-width: 2px;
    border-color: rgba(128, 128, 128, 0.20);
    border-left-color: rgba(128, 128, 128, 0.38);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.transform-default-ui .unity-foldout__toggle {
    margin: 0;
}

.transform-default-ui .unity-foldout__text {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(150, 165, 185, 0.95);
}

.transform-default-ui .unity-foldout__checkmark {
    -unity-background-image-tint-color: rgba(150, 165, 185, 0.95);
}

.transform-default-ui .unity-foldout__toggle:hover .unity-foldout__text {
    color: rgb(190, 205, 225);
}

.transform-default-ui .unity-foldout__content {
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.18);
}

/* ---------- other card ---------- */

.transform-other__section {
    margin: 0 0 4px 0;
}

.transform-other__section-title {
    margin: 6px 0 3px 0;
    padding-bottom: 2px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(145, 180, 235, 0.95);
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.22);
}

.transform-other__row {
    flex-direction: row;
    align-items: center;
}

.transform-other__path {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 4px 0 0;
}

.transform-other__path .unity-base-field__label {
    display: none;
}

.transform-other__enum {
    margin: 0 0 4px 0;
}

.transform-other__enum .unity-base-field__label {
    display: none;
}

.transform-other__button-row {
    flex-direction: row;
}

.transform-other__button {
    flex-grow: 1;
    height: 24px;
    margin: 0 4px 0 0;
    padding: 0 6px;
    font-size: 10px;
}

.transform-other__button--wide {
    margin: 4px 0 0 0;
}

.transform-other__precision-row {
    flex-direction: row;
}

.transform-other__precision {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
}

.transform-other__precision--last {
    margin-right: 0;
}

.transform-other__precision-label {
    margin-bottom: 1px;
    font-size: 9px;
    color: rgba(160, 160, 160, 0.9);
}

.transform-other__slider {
    margin: 0;
}

.transform-other__slider .unity-base-field__label {
    display: none;
}

.transform-other__slider .unity-base-slider__input {
    flex-grow: 1;
}

/* ---------- expression suggestions ---------- */

.transform-suggest {
    position: absolute;
    display: none;
    padding: 4px;
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.65);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.transform-suggest__list {
    flex-direction: column;
}

.transform-suggest__row {
    flex-direction: row;
    align-items: center;
    padding: 2px 5px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.transform-suggest__row:hover,
.transform-suggest__row--selected {
    background-color: rgba(76, 141, 255, 0.38);
}

.transform-suggest__syntax {
    width: 92px;
    min-width: 92px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(170, 205, 255);
}

.transform-suggest__description {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 10px;
    color: rgba(215, 215, 215, 0.95);
    white-space: normal;
}

.transform-suggest__footer {
    margin-top: 3px;
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.35);
    font-size: 9px;
    color: rgba(150, 150, 150, 0.9);
}

.transform-path .unity-base-field__label {
    min-width: 90px;
}

.link-slot {
    width: 20px;
    min-width: 20px;
    margin-right: 4px;
    align-self: center;
    justify-content: center;
}

.link-slot .icon-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    background-size: 16px 16px;
    border-radius: 2px;
}

.extra-slot {
    padding: 0;
    margin: 0 0 0 4px;
    justify-content: center;
    align-items: center;
    align-self: center;
}

.icon-button {
    border-radius: 3px;
    border-width: 0;
    padding: 0;
    margin: 0;
    width: 16px;
    height: 16px;
    background-size: 13px 13px;
    background-position: center;
    background-repeat: no-repeat;
    justify-content: center;
    align-self: center;
}

.icon-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
    transition: background-color 0.12s ease-in-out;
}

.icon-button.flash {
    background-color: rgba(255, 255, 255, 0.25);
}
