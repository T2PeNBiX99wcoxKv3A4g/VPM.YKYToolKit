.import-log-item {
    flex-direction: column;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
}

.import-log-item__segment {
    flex-direction: row;
    align-items: center;
}

.import-log-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.import-log-item__icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    flex-shrink: 0;
}

.import-log-item__name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    -unity-font-style: normal;
}

.import-log-item__time {
    font-size: 10px;
    color: gray;
    margin-left: 8px;
    flex-shrink: 0;
}
