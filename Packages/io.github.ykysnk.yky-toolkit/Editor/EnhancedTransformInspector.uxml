<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/EnhancedTransformInspector.uss?fileID=7433441132597879392&amp;guid=f73a8c4781e128b4180a465abad72513&amp;type=3#EnhancedTransformInspector"/>
    <ui:VisualElement>
        <ui:Foldout text="label.enhanced_transform_inspector.default_ui" value="false" name="defaultGUIFoldout">
            <ui:IMGUIContainer name="defaultGUI"/>
        </ui:Foldout>
        <ui:VisualElement class="row" style="justify-content: space-between;">
            <ui:Label text="label.enhanced_transform_inspector.local_space" parse-escape-sequences="true"
                      display-tooltip-when-elided="true" class="space-title"/>
            <ui:VisualElement class="row">
                <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="randomLocalAll"/>
                <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="resetLocalAll"/>
                <ui:Button text="label.enhanced_transform_inspector.copy_transform" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="copyLocalTransform" class="cell"/>
                <ui:Button text="label.enhanced_transform_inspector.paste_transform" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="pasteLocalTransform" class="cell"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="position" binding-path="m_LocalPosition"
                                                                         label="label.enhanced_transform_inspector.local_position"
                                                                         reset-button-tooltip="label.enhanced_transform_inspector.reset_position"
                                                                         random-button-tooltip="label.enhanced_transform_inspector.random_position"/>
        <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="rotation"
                                                                         binding-path="m_LocalEulerAnglesHint"
                                                                         label="label.enhanced_transform_inspector.local_rotation"
                                                                         reset-button-tooltip="label.enhanced_transform_inspector.reset_rotation"
                                                                         random-button-tooltip="label.enhanced_transform_inspector.random_rotation"/>
        <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="scale" binding-path="m_LocalScale"
                                                                         label="label.enhanced_transform_inspector.local_scale"
                                                                         show-link-button="true"
                                                                         random-button-tooltip="label.enhanced_transform_inspector.random_scale"
                                                                         reset-button-tooltip="label.enhanced_transform_inspector.reset_scale"/>
        <ui:VisualElement class="row" style="justify-content: space-between;">
            <ui:Label text="label.enhanced_transform_inspector.global_space" parse-escape-sequences="true"
                      display-tooltip-when-elided="true" class="space-title"/>
            <ui:VisualElement class="row">
                <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="randomGlobalAll"/>
                <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="resetGlobalAll"/>
                <ui:Button text="label.enhanced_transform_inspector.copy_transform" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="copyGlobalTransform" class="cell"/>
                <ui:Button text="label.enhanced_transform_inspector.paste_transform" parse-escape-sequences="true"
                           display-tooltip-when-elided="true" name="pasteGlobalTransform" class="cell"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="globalPosition"
                                                                         label="label.enhanced_transform_inspector.global_position"
                                                                         reset-button-tooltip="label.enhanced_transform_inspector.reset_position"
                                                                         random-button-tooltip="label.enhanced_transform_inspector.random_position"/>
        <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="globalRotation"
                                                                         label="label.enhanced_transform_inspector.global_rotation"
                                                                         reset-button-tooltip="label.enhanced_transform_inspector.reset_rotation"
                                                                         random-button-tooltip="label.enhanced_transform_inspector.random_rotation"/>
        <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="lossyScale"
                                                                         label="label.enhanced_transform_inspector.global_scale"
                                                                         show-link-button="true"
                                                                         reset-button-tooltip="label.enhanced_transform_inspector.reset_scale"
                                                                         random-button-tooltip="label.enhanced_transform_inspector.random_scale"/>
        <ui:Foldout text="label.enhanced_transform_inspector.help" name="helpFoldout">
            <ui:Label tabindex="-1" text="label.enhanced_transform_inspector.helpText" parse-escape-sequences="true"
                      display-tooltip-when-elided="true" name="helpText" style="white-space: normal; flex-wrap: wrap;"/>
        </ui:Foldout>
        <ui:Label text="label.enhanced_transform_inspector.other" parse-escape-sequences="true"
                  display-tooltip-when-elided="true" class="space-title"/>
        <ui:Vector3Field label="label.enhanced_transform_inspector.bounds_size" name="boundsSize"/>
        <ui:TextField picking-mode="Ignore" label="label.enhanced_transform_inspector.hierarchy_path"
                      value="filler text" name="hierarchyPath" readonly="true"/>
        <uie:ObjectField label="label.enhanced_transform_inspector.father" binding-path="m_Father" name="father"
                         type="UnityEngine.Transform, UnityEngine.CoreModule" class="readonly-object-field"/>
        <ui:ListView virtualization-method="DynamicHeight" show-border="true"
                     show-alternating-row-backgrounds="ContentOnly" name="childrenList"
                     header-title="label.enhanced_transform_inspector.children" show-foldout-header="true"/>
        <ui:VisualElement class="row">
            <ui:Button text="label.enhanced_transform_inspector.align_to_parent" parse-escape-sequences="true"
                       display-tooltip-when-elided="true" name="alignToParent" class="cell"/>
            <ui:Button text="label.enhanced_transform_inspector.align_to_ground" parse-escape-sequences="true"
                       display-tooltip-when-elided="true" name="alignToGround" class="cell"/>
        </ui:VisualElement>
        <ui:EnumField label="label.enhanced_transform_inspector.align_mode"
                      type="io.github.ykysnk.ykyToolkit.Editor.AlignMode, io.github.ykysnk.yky-toolkit.Editor"
                      name="alignMode"/>
        <ui:VisualElement class="row" style="flex-grow: 1;">
            <ui:Button text="label.enhanced_transform_inspector.clear_parent" parse-escape-sequences="true"
                       display-tooltip-when-elided="true" name="clearParent" class="cell"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
