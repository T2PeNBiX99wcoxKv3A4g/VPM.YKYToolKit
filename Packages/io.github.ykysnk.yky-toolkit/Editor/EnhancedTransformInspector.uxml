<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/YkyToolkitTheme.uss?guid=34e0c41dada851146aeccffc05549196&amp;type=3"/>
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/EnhancedTransformInspector.uss?fileID=7433441132597879392&amp;guid=f73a8c4781e128b4180a465abad72513&amp;type=3#EnhancedTransformInspector"/>
    <ui:VisualElement class="transform-editor">
        <ui:VisualElement class="yky-card transform-card">
            <ui:VisualElement class="transform-card__header">
                <ui:Label text="label.enhanced_transform_inspector.local_space" class="transform-card__title"/>
                <ui:VisualElement class="yky-spacer"/>
                <ui:VisualElement class="transform-actions">
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="copyLocalAll"
                                                                              tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                              class="transform-action"
                                                                              style="background-image: url(&quot;project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/copy.png?fileID=2800000&amp;guid=f8379f706ae3d4841838ff5cc924da0a&amp;type=3#copy&quot;);"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="pasteLocalAll"
                                                                              tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                              class="transform-action"
                                                                              style="background-image: url(&quot;project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/paste.png?fileID=2800000&amp;guid=3d32b439cc5c09f4f93312cf317a8019&amp;type=3#paste&quot;);"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="randomLocalAll"
                                                                              tooltip="label.enhanced_transform_inspector.random_all"
                                                                              class="transform-action"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="resetLocalAll"
                                                                              tooltip="label.enhanced_transform_inspector.reset_all"
                                                                              class="transform-action"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="position" binding-path="m_LocalPosition"
                                                                             label="unity:label.position"
                                                                             reset-button-tooltip="label.enhanced_transform_inspector.reset_position"
                                                                             random-button-tooltip="label.enhanced_transform_inspector.random_position"
                                                                             show-copy-paste-buttons="true"
                                                                             copy-button-tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                             paste-button-tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                             class="localize-tooltip"/>
            <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="rotation"
                                                                             label="unity:label.rotation"
                                                                             reset-button-tooltip="label.enhanced_transform_inspector.reset_rotation"
                                                                             random-button-tooltip="label.enhanced_transform_inspector.random_rotation"
                                                                             show-copy-paste-buttons="true"
                                                                             copy-button-tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                             paste-button-tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                             class="localize-tooltip"/>
            <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="scale" binding-path="m_LocalScale"
                                                                             label="unity:label.scale"
                                                                             show-link-button="true"
                                                                             random-button-tooltip="label.enhanced_transform_inspector.random_scale"
                                                                             reset-button-tooltip="label.enhanced_transform_inspector.reset_scale"
                                                                             link-button-binding-path="m_ConstrainProportionsScale"
                                                                             show-copy-paste-buttons="true"
                                                                             copy-button-tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                             paste-button-tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                             class="localize-tooltip"/>
        </ui:VisualElement>

        <ui:VisualElement class="yky-card transform-card">
            <ui:VisualElement class="transform-card__header">
                <ui:Label text="label.enhanced_transform_inspector.global_space" class="transform-card__title"/>
                <ui:VisualElement class="yky-spacer"/>
                <ui:VisualElement class="transform-actions">
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="copyGlobalAll"
                                                                              tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                              class="transform-action"
                                                                              style="background-image: url(&quot;project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/copy.png?fileID=2800000&amp;guid=f8379f706ae3d4841838ff5cc924da0a&amp;type=3#copy&quot;);"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="pasteGlobalAll"
                                                                              tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                              class="transform-action"
                                                                              style="background-image: url(&quot;project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/Icons/paste.png?fileID=2800000&amp;guid=3d32b439cc5c09f4f93312cf317a8019&amp;type=3#paste&quot;);"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="randomGlobalAll"
                                                                              tooltip="label.enhanced_transform_inspector.random_all"
                                                                              class="transform-action"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="resetGlobalAll"
                                                                              tooltip="label.enhanced_transform_inspector.reset_all"
                                                                              class="transform-action"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="globalPosition"
                                                                             reset-button-tooltip="label.enhanced_transform_inspector.reset_position"
                                                                             random-button-tooltip="label.enhanced_transform_inspector.random_position"
                                                                             label="unity:label.position"
                                                                             show-copy-paste-buttons="true"
                                                                             copy-button-tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                             paste-button-tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                             class="localize-tooltip"/>
            <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="globalRotation"
                                                                             label="unity:label.rotation"
                                                                             reset-button-tooltip="label.enhanced_transform_inspector.reset_rotation"
                                                                             random-button-tooltip="label.enhanced_transform_inspector.random_rotation"
                                                                             show-copy-paste-buttons="true"
                                                                             copy-button-tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                             paste-button-tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                             class="localize-tooltip"/>
            <io.github.ykysnk.ykyToolkit.Editor.UIElements.Vector3FieldExtra name="lossyScale"
                                                                             label="unity:label.scale"
                                                                             show-link-button="true"
                                                                             reset-button-tooltip="label.enhanced_transform_inspector.reset_scale"
                                                                             random-button-tooltip="label.enhanced_transform_inspector.random_scale"
                                                                             link-button-binding-path="m_ConstrainProportionsScale"
                                                                             show-copy-paste-buttons="true"
                                                                             copy-button-tooltip="label.enhanced_transform_inspector.copy_transform"
                                                                             paste-button-tooltip="label.enhanced_transform_inspector.paste_transform"
                                                                             class="localize-tooltip"/>
        </ui:VisualElement>

        <ui:VisualElement class="yky-card transform-card transform-other">
            <ui:VisualElement class="transform-card__header">
                <ui:Label text="label.enhanced_transform_inspector.other" class="transform-card__title"/>
                <ui:VisualElement class="yky-spacer"/>
                <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="lockTransform"
                                                                          tooltip="label.enhanced_transform_inspector.lock_transform"
                                                                          class="transform-action"/>
                <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="openHelp"
                                                                          tooltip="label.enhanced_transform_inspector.help"
                                                                          class="transform-action"/>
            </ui:VisualElement>

            <ui:VisualElement class="transform-other__section">
                <ui:Label text="label.enhanced_transform_inspector.hierarchy_path"
                          class="transform-other__section-title"/>
                <ui:VisualElement class="transform-other__row">
                    <ui:TextField name="hierarchyPath" readonly="true" picking-mode="Ignore"
                                  class="transform-path transform-other__path"/>
                    <io.github.ykysnk.ykyToolkit.Editor.UIElements.IconButton name="copyPath"
                                                                              tooltip="label.copy"
                                                                              class="transform-action"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="transform-other__section">
                <ui:Label text="label.enhanced_transform_inspector.section_alignment"
                          class="transform-other__section-title"/>
                <ui:EnumField type="io.github.ykysnk.ykyToolkit.Editor.AlignMode, io.github.ykysnk.yky-toolkit.Editor"
                              name="alignMode" class="transform-other__enum"/>
                <ui:VisualElement class="transform-other__button-row">
                    <ui:Button text="label.enhanced_transform_inspector.align_to_parent" name="alignToParent"
                               class="transform-other__button"/>
                    <ui:Button text="label.enhanced_transform_inspector.align_to_ground" name="alignToGround"
                               class="transform-other__button"/>
                </ui:VisualElement>
                <ui:Button text="label.enhanced_transform_inspector.clear_parent" name="clearParent"
                           class="transform-other__button transform-other__button--wide"/>
            </ui:VisualElement>

            <ui:VisualElement class="transform-other__section">
                <ui:Label text="label.enhanced_transform_inspector.section_precision"
                          class="transform-other__section-title"/>
                <ui:VisualElement class="transform-other__precision-row">
                    <ui:VisualElement class="transform-other__precision">
                        <ui:Label text="unity:label.position" class="transform-other__precision-label"/>
                        <ui:SliderInt high-value="6" show-input-field="true" name="positionDecimal" low-value="-1"
                                      class="transform-other__slider"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="transform-other__precision">
                        <ui:Label text="unity:label.rotation" class="transform-other__precision-label"/>
                        <ui:SliderInt high-value="6" show-input-field="true" name="rotationDecimal" low-value="-1"
                                      class="transform-other__slider"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="transform-other__precision transform-other__precision--last">
                        <ui:Label text="unity:label.scale" class="transform-other__precision-label"/>
                        <ui:SliderInt high-value="6" show-input-field="true" name="scaleDecimal" low-value="-1"
                                      class="transform-other__slider"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Foldout text="label.enhanced_transform_inspector.default_ui" value="false" name="defaultGUIFoldout"
                    class="transform-default-ui">
            <ui:IMGUIContainer name="defaultGUI"/>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
