<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/UpmPackageListWrapperEditor.uss?fileID=7433441132597879392&amp;guid=bb0de447f8c41b547adea973d09de041&amp;type=3#UpmPackageListWrapperEditor"/>
    <ui:VisualElement style="flex-direction: row;">
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" binding-path="wrapName"
                   text="New Package List" name="import" class="cell"/>
    </ui:VisualElement>
    <ui:ListView selection-type="Multiple" show-alternating-row-backgrounds="ContentOnly"
                 virtualization-method="DynamicHeight" show-border="true" reorderable="true"
                 show-add-remove-footer="true" reorder-mode="Animated" show-bound-collection-size="true"
                 binding-path="wrapPackages" name="ListView" show-foldout-header="true"
                 header-title="label.upm_package_list_wrapper.packages"/>
</ui:UXML>
