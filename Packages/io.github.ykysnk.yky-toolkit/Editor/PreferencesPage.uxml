<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/YkyToolkitTheme.uss?guid=34e0c41dada851146aeccffc05549196&amp;type=3"/>
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/PreferencesPage.uss?fileID=7433441132597879392&amp;guid=d16273d813d4ff74482b362d3570add2&amp;type=3#PreferencesPage"/>
    <ui:ScrollView class="root yky-preferences">
        <ui:VisualElement class="yky-preferences__content">
            <ui:VisualElement class="yky-preferences__header">
                <ui:VisualElement class="yky-icon yky-icon--header yky-icon--preferences"/>
                <ui:Label text="YKY Toolkit" class="yky-preferences__title"/>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card yky-card--language">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--language"/>
                    <ui:Label text="label.language" class="yky-section"/>
                </ui:VisualElement>
                <ui:VisualElement name="languagePickerHost" class="yky-language-picker-host"/>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--theme"/>
                    <ui:Label text="label.preferences_page.appearance" class="yky-section"/>
                    <ui:VisualElement class="yky-spacer"/>
                    <ui:Button name="resetAppearance" tooltip="label.preferences_page.reset_appearance"
                               class="yky-icon-button yky-button-icon--reset"/>
                </ui:VisualElement>
                <uie:ColorField label="label.preferences_page.accent_color" name="accentColor"/>
                <ui:Label text="label.preferences_page.accent_color_hint" class="yky-hint"/>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--settings"/>
                    <ui:Label text="label.preferences_page.general" class="yky-section"/>
                    <ui:VisualElement class="yky-spacer"/>
                    <ui:Button name="resetGeneral" tooltip="label.import_watcher.reset_colors"
                               class="yky-icon-button yky-button-icon--reset"/>
                </ui:VisualElement>
                <ui:Toggle label="label.preferences_page.allow_async_compilation" name="allowAsyncCompilation"/>
                <ui:Toggle label="label.preferences_page.delete_selected_warn_window"
                           name="deleteSelectedWarnWindow"/>
                <ui:Toggle label="label.preferences_page.enable_discord_rich_presence"
                           name="enableDiscordRichPresence"/>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--delete-history"/>
                    <ui:Label text="label.preferences_page.delete_protection" class="yky-section"/>
                </ui:VisualElement>
                <ui:Label text="label.preferences_page.delete_protection_hint" class="yky-hint"/>
                <ui:VisualElement class="yky-list-header">
                    <ui:Label text="label.preferences_page.extra_protected_directories" class="yky-list-title"/>
                    <ui:Label name="protectedDirectoryCount" text="0" class="yky-count"/>
                    <ui:VisualElement class="yky-spacer"/>
                </ui:VisualElement>
                <ui:ListView name="extraProtectedDirectories"
                             show-alternating-row-backgrounds="ContentOnly" selection-type="Multiple"
                             virtualization-method="DynamicHeight"
                             class="yky-list yky-preferences__protected-list"/>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--delete-history"/>
                    <ui:Label text="label.delete_history_manager" class="yky-section"/>
                    <ui:VisualElement class="yky-spacer"/>
                    <ui:Button name="resetDeleteHistory" tooltip="label.import_watcher.reset_colors"
                               class="yky-icon-button yky-button-icon--reset"/>
                </ui:VisualElement>
                <ui:SliderInt label="label.delete_history_manager.max_records" high-value="1000" low-value="1"
                              show-input-field="true" name="deleteHistoryManagerMaxRecords"/>
            </ui:VisualElement>

            <ui:VisualElement class="yky-card">
                <ui:VisualElement class="yky-card__title">
                    <ui:VisualElement class="yky-icon yky-icon--section yky-icon--import-watcher"/>
                    <ui:Label text="label.preferences_page.import_watcher" class="yky-section"/>
                    <ui:VisualElement class="yky-spacer"/>
                    <ui:Button name="resetImportWatcher" tooltip="label.import_watcher.reset_colors"
                               class="yky-icon-button yky-button-icon--reset"/>
                </ui:VisualElement>
                <uie:ColorField label="label.import_watcher.color" value="RGBA(0.000, 1.000, 1.000, 1.000)"
                                name="importWatcherColor"/>
                <ui:SliderInt label="label.import_watcher.duration" high-value="500" name="importWatcherDuration"
                              show-input-field="true"/>
                <ui:SliderInt label="label.import_watcher.max_sessions" high-value="1000"
                              name="importWatcherMaxSessionsField" show-input-field="true" low-value="1"/>

                <ui:VisualElement class="yky-list-header">
                    <ui:Label text="label.import_watcher.file_extension_colors" class="yky-list-title"/>
                    <ui:Label name="fileColorCount" text="0" class="yky-count"/>
                </ui:VisualElement>
                <ui:ListView reorder-mode="Animated" reorderable="true"
                             show-alternating-row-backgrounds="ContentOnly" selection-type="Multiple"
                             virtualization-method="DynamicHeight"
                             name="importWatcherFileExtensionColors" class="yky-list"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
