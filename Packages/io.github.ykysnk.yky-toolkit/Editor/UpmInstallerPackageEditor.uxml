<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.yky-toolkit/Editor/UpmInstallerPackageEditor.uss?fileID=7433441132597879392&amp;guid=9aa3e19cdecaabe428375cc9adec98b7&amp;type=3#UpmInstallerPackageEditor"/>
